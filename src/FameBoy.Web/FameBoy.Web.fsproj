<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <None Include="index.html" />
        <None Include="vite.config.ts" />
        <None Include="package.json" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
        <PackageReference Include="Fable.Core" Version="5.0.0-rc.1" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptCompile Include="vite.config.ts" />
    </ItemGroup>

</Project>
