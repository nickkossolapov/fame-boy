<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>fame-boy</AssemblyName>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="RaylibBindings.fs" />
        <Compile Include="Config.fs" />
        <Compile Include="Joypad.fs" />
        <Compile Include="Utils.fs" />
        <Compile Include="Graphics.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FameBoy\FameBoy.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="7.0.2" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
